{
  "name": "@nl-design-system-unstable/vidar-design-tokens",
  "version": "1.0.0",
  "author": "Community for NL Design System",
  "description": "NL Design System design tokens voor Vidar thema",
  "website": "https://www.nldesignsystem.nl/",
  "keywords": [
    "nl-design-system"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/themes.git",
    "directory": "proprietary/vidar-design-tokens"
  },
  "scripts": {
    "clean": "rimraf -rf dist/",
    "watch": "npm-run-all watch:**",
    "watch:style-dictionary": "chokidar --follow-symlinks --command 'pnpm run build' 'figma/**/*.tokens.json'",
    "build": "npm-run-all clean build:style-dictionary",
    "build:style-dictionary": "node ./style-dictionary.mjs"
  },
  "devDependencies": {
    "@amsterdam/design-system-react": "4.1.0",
    "@nl-design-system-community/design-tokens-definition": "workspace:*",
    "@nl-design-system-unstable/design-tokens-table-react": "workspace:*",
    "@nl-design-system-unstable/theme-toolkit": "workspace:*",
    "@storybook/addon-docs": "9.1.17",
    "@storybook/react-vite": "9.1.17",
    "@tokens-studio/sd-transforms": "1.2.3",
    "@types/react": "19.2.18",
    "chokidar-cli": "3.0.0",
    "html-react-parser": "5.1.12",
    "npm-run-all": "4.1.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "6.0.1",
    "style-dictionary": "4.0.1"
  }
}
